<?xml version="1.0" encoding="UTF-8"?>
<vstgui-ui-description version="1">
    <colors>
        <color name="Background" rgba="#080B12FF"/>
        <color name="Panel" rgba="#141B29FF"/>
        <color name="PanelEdge" rgba="#34445EFF"/>
        <color name="LCD" rgba="#062D3AFF"/>
        <color name="LCDInner" rgba="#0A4250FF"/>
        <color name="Accent" rgba="#00E5FFFF"/>
        <color name="Text" rgba="#F4FBFFFF"/>
        <color name="Muted" rgba="#9CB7C4FF"/>
        <color name="Button" rgba="#1D3044FF"/>
        <color name="ButtonEdge" rgba="#00BBD5FF"/>
        <color name="ButtonText" rgba="#FFFFFF"/>
        <color name="Green" rgba="#55FFB0FF"/>
        <color name="Gold" rgba="#FFD166FF"/>
    </colors>

    <fonts>
        <font name="BrandFont" font-name="Arial" size="22" bold="true"/>
        <font name="ButtonFont" font-name="Arial" size="11" bold="true"/>
        <font name="LabelFont" font-name="Arial" size="12" bold="true"/>
        <font name="DisplayFont" font-name="Arial" size="25" bold="true"/>
        <font name="ValueFont" font-name="Arial" size="22" bold="true"/>
        <font name="SmallFont" font-name="Arial" size="11"/>
    </fonts>

    <template name="view" class="CViewContainer" size="900,520"
              background-color="Background">

        <view class="CViewContainer" origin="12,12" size="876,496"
              background-color="Panel">

            <view class="CTextLabel" origin="24,12" size="828,30"
                  font="BrandFont" title="DJ RH AUDIO ZONE"
                  text-color="Accent"/>

            <view class="CTextLabel" origin="24,44" size="828,20"
                  font="SmallFont" title="134 TONES  |  MIDI INSTRUMENT"
                  text-color="Muted"/>

            <!-- Center LCD -->
            <view class="CViewContainer" origin="132,76" size="612,386"
                  background-color="LCD">
                <view class="CViewContainer" origin="5,5" size="602,376"
                      background-color="LCDInner"/>

                <view class="CTextLabel" origin="34,25" size="544,24"
                      font="LabelFont" title="CURRENT TONE"
                      text-color="Accent"/>

                <!-- StringListParameter contains number and tone name -->
                <view class="CParamDisplay" origin="34,58" size="544,66"
                      control-tag="1000" font="DisplayFont"
                      font-color="Text" back-color="LCD"
                      round-radius="7"/>

                <view class="CTextLabel" origin="34,151" size="250,22"
                      font="LabelFont" title="VOLUME"
                      text-color="Muted"/>
                <view class="CParamDisplay" origin="34,178" size="250,55"
                      control-tag="1010" font="ValueFont"
                      font-color="Green" back-color="LCD"
                      value-precision="0" round-radius="6"/>

                <view class="CTextLabel" origin="328,151" size="250,22"
                      font="LabelFont" title="RELEASE"
                      text-color="Muted"/>
                <view class="CParamDisplay" origin="328,178" size="250,55"
                      control-tag="1011" font="ValueFont"
                      font-color="Gold" back-color="LCD"
                      value-precision="0" round-radius="6"/>

                <view class="CTextLabel" origin="34,266" size="544,22"
                      font="LabelFont" title="OCT / SEMITONE SHIFT"
                      text-color="Muted"/>
                <view class="CParamDisplay" origin="34,293" size="544,55"
                      control-tag="1012" font="ValueFont"
                      font-color="Accent" back-color="LCD"
                      value-precision="0" round-radius="6"/>
            </view>

            <!-- Left buttons: TONE-, TONE+, REL-, REL+ -->
            <view class="CTextButton" origin="24,78" size="84,78"
                  title="TONE−" control-tag="2001"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="24,176" size="84,78"
                  title="TONE+" control-tag="2002"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="24,274" size="84,78"
                  title="REL−" control-tag="2003"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="24,372" size="84,78"
                  title="REL+" control-tag="2004"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />

            <!-- Right buttons: VOL-, VOL+, OCT-, OCT+ -->
            <view class="CTextButton" origin="768,78" size="84,78"
                  title="VOL−" control-tag="2005"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="768,176" size="84,78"
                  title="VOL+" control-tag="2006"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="768,274" size="84,78"
                  title="OCT−" control-tag="2007"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />
            <view class="CTextButton" origin="768,372" size="84,78"
                  title="OCT+" control-tag="2008"
                  font="ButtonFont" kick-style="true"
                  round-radius="39" />

        </view>
    </template>
</vstgui-ui-description>
