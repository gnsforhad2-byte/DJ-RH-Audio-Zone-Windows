{
  "name": "dj-rh-audio-zone",
  "version": "1.0.0",
  "description": "DJ RH Audio Zone Windows Desktop App",
  "main": "main.js",
  "author": "DJ RH Audio Zone",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run build:native:win && npm run build:vst3:win && electron-builder --win nsis --x64 --publish never",
    "build:native:win": "node-gyp rebuild --target=45.2.3 --arch=x64 --runtime=electron --dist-url=https://electronjs.org/headers",
    "install": "node -e \"process.exit(0)\"",
    "build:vst3:win": "cmake -S native/vst3 -B build/vst3-cmake -A x64 -DSMTG_CREATE_PLUGIN_LINK=OFF && cmake --build build/vst3-cmake --config Release --target DJRH_Audio_Zone"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "node-gyp": "11.5.0"
  },
  "build": {
    "appId": "com.djrh.audiozone",
    "productName": "DJ RH Audio Zone",
    "asar": false,
    "files": [
      "main.js",
      "audio-worklet.js",
      "preload.js",
      "index.html",
      "tones.json",
      "tones/**/*",
      "style_loops/**/*",
      "build/Release/wasapi.node",
      "native/vendor/rtaudio/LICENSE",
      "build/Release/asio-helper.exe"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DJ-RH-Audio-Zone-Setup-${version}.${ext}",
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/app-icon.ico",
      "uninstallerIcon": "assets/app-icon.ico",
      "allowElevation": true,
      "include": "installer/installer.nsh"
    }
  }
}
